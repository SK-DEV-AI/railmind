# Copy to .env and fill in. .env is gitignored. Never commit a real key.
# Empty values are fine: the app must start with every key missing and say which
# features are disabled, not crash.

# --- Rail data (Step 2) -------------------------------------------------------
# railradar.in -> developer dashboard. Free sandbox, no card required.
# Check what the dashboard actually says for your plan: our research found a
# conflict (docs said 100 req/month, a third-party repo claimed 300 req/day).
RAILRADAR_API_KEY=
# Optional fallback provider, free tier 500k req/month per vendor claim.
RAPIDAPI_KEY=

# --- Intent parsing (Step 3) --------------------------------------------------
# Any OpenAI-compatible endpoint works. LLM_API_KEYS is comma separated and
# rotated round-robin, so one drained key does not stop the agent.
LLM_BASE_URL=
LLM_API_KEYS=
LLM_MODEL=
# Groq free tier, verified 2026-10-24 (11 models on the account):
#   openai/gpt-oss-120b      131k ctx, best structured output  <- default
#   openai/gpt-oss-20b       131k ctx, faster, weaker
#   qwen/qwen3.8-27b         131k ctx
#   whisper-large-v3-turbo   speech to text, for voice input in the demo
# Keys: https://console.groq.com/keys
# Not on the account any more: llama-3.3-70b-versatile. Check
# /openai/v1/models before pinning a name; the catalogue moves.

# --- Optional, not needed for the viva ---------------------------------------
# MapTiler free key only if default OSM raster tiles are too slow.
MAPTILER_KEY=

# --- Runtime ------------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=info
# Where the append-only audit log and the measured metrics come from.
AUDIT_LOG_PATH=data/audit.jsonl
